[mgr]
linemode = "size"
ratio = [1,3,4]
show_hidden = true
show_symlink = true
sort_by = "alphabetical"
sort_dir_first = true
sort_reverse = false
sort_sensitive = false

[preview]
image_delay = 100
image_filter = "lanczos3"
image_quality = 90
max_width = 2096
max_height = 2096
wrap = "yes"

[tasks]
#image_alloc = 0
#image_bound = 0
macro_workers = 8
micro_workers = 24

[input]
cursor_blink = true

[which]
sort_reverse = false
sort_sensitive = false

[commands]
name = "play-audio"
command = "mpv {}"
args = ["file_path"]
description = "Play an audio file using mpv"

[file_list]
display_time = true
time_format = "%M-%d-%y %H:%M"
size = "human_readable"
show_symlink = true

[opener]
edit = [
  { run = 'codium "$@"', block = true },
]

image = [
  { run = 'nomacs "$@"', desc = "Open with nomacs" },
]

video = [
  { run = 'vlc "$@"', desc = "Open with VLC" },
]

audio = [
  { run = 'mpv --no-video "$@"', desc = "Open with mpv" },
]

[open]
prepend_rules = [
  { name = "*.md",   use = "edit" },
  { name = "*.txt",  use = "edit" },
  { name = "*.py",   use = "edit" },
  { name = "*.sh",   use = "edit" },
  { name = "*.json", use = "edit" },
  { name = "*.nix",  use = "edit" }, 
  { name = "*.toml", use = "edit" },
  
  { name = "*.png",  use = "image" },
  { name = "*.jpg",  use = "image" },
  { name = "*.webp", use = "image" },
  
  { name = "*.mp4",  use = "video" },
  { name = "*.mkv",  use = "video" },
  
  { name = "*.mp3",  use = "audio" },
  { name = "*.wav",  use = "audio" },
]

# Everything else uses KDE default
open = [
  { run = 'xdg-open "$@"', desc = "Open with system default" },
]
