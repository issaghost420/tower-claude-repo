// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "language_models": {
    "openai_compatible": {
      
    },
    "ollama": {
      "context_window": 32768,
      "api_url": "http://localhost:11434/v1/completions"
    }
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "terminal": {
    "max_scroll_history_lines": 50000,
    "copy_on_select": true
  },
  "debugger": {
    "stepping_granularity": "instruction"
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true
  },
  "tabs": {
    "show_diagnostics": "all",
    "activate_on_close": "neighbour",
    "file_icons": false
  },
  "title_bar": {
    "button_layout": "platform_default"
  },
  "status_bar": {
    "show_active_file": false,
    "line_endings_button": true
  },
  "file_finder": {
    "modal_max_width": "small"
  },
  "search": {
    "regex": true
  },
  "use_smartcase_search": true,
  "semantic_tokens": "combined",
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",
  "which_key": {
    "enabled": true
  },
  "autosave": "off",
  "colorize_brackets": true,
  "middle_click_paste": true,
  "code_lens": "on",
  "inlay_hints": {
    "enabled": true
  },
  "completion_menu_item_kind": "symbol",
  "show_whitespaces": "all",
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "vim": {
    "cursor_shape": {
      "normal": "hollow"
    }
  },
  "minimap": {
    "show": "auto"
  },
  "relative_line_numbers": "enabled",
  "show_signature_help_after_edits": true,
  "auto_signature_help": true,
  "sticky_scroll": {
    "enabled": true
  },
  "autoscroll_on_clicks": true,
  "mouse_wheel_zoom": true,
  "double_click_in_multibuffer": "open",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400.0,
  "buffer_font_family": "Unifont-T",
  "when_closing_with_no_tabs": "close_window",
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "system",
    "light": "Zedless (Default)",
    "dark": "Zedless (Default)"
  },
  "vim_mode": false,
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "parser": "",
    "allowed": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no",
    "ollama": {
      "api_url": "http://localhost:8001",
      "prompt_format": "infer"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "project_panel": {
    "dock": "left"
  },
  "agent": {
    "show_turn_stats": true,
    "single_file_review": true,
    "inline_assistant_model": {
      "provider": "lmstudio",
      "model": "zai-org/glm-4.7-flash",
      "enable_thinking": false
    },
    "profiles": {
      "hacks-2": {
        "name": "hacks2",
        "tools": {
          "read_file": true
        },
        "enable_all_context_servers": false,
        "context_servers": {
          "local-files": {
            "tools": {
              "read_file": true,
              "edit_file": false,
              "directory_tree": true
            }
          }
        },
        "default_model": {
          "provider": "lmstudio",
          "model": "nvidia/nemotron-3-nano",
          "enable_thinking": false
        }
      },
      "hacks": {
